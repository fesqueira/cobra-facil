# Copie para .env e ajuste.
DATABASE_URL=postgres://cobra:cobra@localhost:5432/cobra
PORT=3000
LOG_LEVEL=info
# Token para criar lojistas (POST /v1/merchants)
ADMIN_TOKEN=troque-este-token-admin
# Segredo compartilhado com o PSP para assinar os webhooks de pagamento
PSP_WEBHOOK_SECRET=troque-este-segredo-do-psp
# Liga os jobs (expiração e entrega de webhooks) no mesmo processo da API
RUN_WORKERS=true
