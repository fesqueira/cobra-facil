{
  "name": "cobra-facil",
  "version": "1.0.0",
  "description": "API de cobranças Pix com idempotência, webhooks assinados e outbox. Node.js, TypeScript, Fastify e PostgreSQL.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "openapi": "tsx scripts/openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "author": "Felipe Siqueira",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fesqueira/cobra-facil.git"
  },
  "keywords": [
    "pix",
    "api",
    "fastify",
    "typescript",
    "postgresql",
    "webhooks",
    "idempotency"
  ]
}
